---
const { current } = Astro.props;
---

<nav>
  <a href="/" class="nav-brand">
    <span class="nav-brand-name">KOKORO-JITSU</span>
    <span class="nav-brand-jp">こころ術</span>
  </a>
  <button class="nav-toggle" id="nav-toggle" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
  <div class="nav-links" id="nav-links">
    <a href="/about" class={current === 'about' ? 'active' : ''}>About</a>
    <a href="/self-defense" class={current === 'self-defense' ? 'active' : ''}>Self Defense</a>
    <a href="/ranks" class={current === 'ranks' ? 'active' : ''}>Ranks</a>
    <a href="/archive" class={current === 'archive' ? 'active' : ''}>Archive</a>
    <a href="/blog" class={current === 'blog' ? 'active' : ''}>Blog</a>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    links?.classList.toggle('open');
  });
  // Close on link click (mobile)
  links?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => links.classList.remove('open'));
  });
</script>
