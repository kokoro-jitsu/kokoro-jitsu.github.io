<style>
.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  padding: 3rem 3rem 2rem;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute; top: -20%; right: 160px;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(255,30,140,0.07) 0%, transparent 70%);
  pointer-events: none;
}
.hero-eyebrow {
  font-size: 11px; letter-spacing: 0.25em; text-transform: uppercase;
  color: var(--pink); margin-bottom: 1.2rem;
  display: inline-block;
  border-bottom: 1px solid rgba(255,30,140,0.35);
  padding-bottom: 1px; transition: border-color 0.2s;
}
.hero-eyebrow:hover { border-color: var(--pink); }
.hero-headline {
  font-family: var(--font-display);
  font-size: clamp(72px, 10vw, 110px);
  line-height: 0.95;
  letter-spacing: 0.02em;
  margin-bottom: 0.6rem;
}
.hero-headline .accent { color: var(--pink); }
.hero-sub { font-family: var(--font-jp); font-size: 13px; color: var(--gray-400); letter-spacing: 0.2em; margin-bottom: 2rem; }
.hero-tagline {
  font-size: 15px; color: var(--gray-400); line-height: 1.85;
  max-width: 460px;
  border-left: 2px solid var(--pink); padding-left: 1.2rem;
  margin-bottom: 2.5rem;
}
.hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }
.hero-social {
  display: flex;
  gap: 16px;
  margin-top: 1.2rem;
  flex-wrap: wrap;
}
.social-link {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gray-400);
  border: 0.5px solid var(--border);
  padding: 6px 14px;
  transition: color 0.2s, border-color 0.2s;
}
.social-link:hover {
  color: var(--pink);
  border-color: var(--pink);
}
.hero-logo { display: flex; align-items: center; justify-content: center; }
.hero-stats {
  grid-column: 1 / -1;
  display: flex;
  border-top: 0.5px solid var(--border);
  padding-top: 2rem; margin-top: 1rem;
}
.hero-stat { flex: 1; padding-right: 2rem; border-right: 0.5px solid var(--border); margin-right: 2rem; }
.hero-stat:last-child { border-right: none; }
.hero-stat-num { font-family: var(--font-display); font-size: 36px; color: var(--pink); line-height: 1; }
.hero-stat-label { font-size: 11px; color: var(--gray-600); text-transform: uppercase; letter-spacing: 0.15em; }

/* Slideshow */
.slideshow-section {
  padding: 3rem 3rem 4rem;
  border-top: 0.5px solid var(--border);
}
.slideshow-eyebrow {
  font-size: 11px; letter-spacing: 0.25em; text-transform: uppercase;
  color: var(--pink); margin-bottom: 1.5rem;
}
.slideshow {
  position: relative;
  width: 100%;
  height: 520px;
  overflow: hidden;
  background: #0a0a0a;
}
.slide {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  opacity: 0;
  transition: opacity 1.2s ease-in-out;
}
.slide.active { opacity: 1; }
.slideshow-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.5) 100%);
  pointer-events: none;
  z-index: 1;
}
.slide-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 3;
  background: rgba(0,0,0,0.5);
  border: 0.5px solid var(--border);
  color: var(--gray-400);
  width: 40px; height: 40px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  transition: color 0.2s, border-color 0.2s, background 0.2s;
}
.slide-arrow:hover {
  color: var(--pink);
  border-color: var(--pink);
  background: rgba(0,0,0,0.8);
}
.slide-arrow.prev { left: 1rem; }
.slide-arrow.next { right: 1rem; }
.slideshow-dots {
  position: absolute;
  bottom: 1.2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
  z-index: 2;
}
.dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  cursor: pointer;
  transition: background 0.3s;
}
.dot.active { background: var(--pink); }

@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
    padding: 2rem 1.5rem;
    gap: 2rem;
  }
  .hero-logo { order: -1; }
  .hero-logo img { max-width: 280px; }
  .hero-stats { flex-wrap: wrap; gap: 1.5rem; }
  .hero-stat { border-right: none; padding-right: 0; margin-right: 0; min-width: 100px; }
  .slideshow-section { padding: 2rem 1.5rem 3rem; }
  .slideshow { height: 300px; }
}
</style>

<script>
  const slides = document.querySelectorAll('#kj-slideshow .slide');
  const dots = document.querySelectorAll('#kj-dots .dot');
  let current = 0;
  let timer;

  function goTo(index) {
    slides[current].classList.remove('active');
    dots[current].classList.remove('active');
    current = (index + slides.length) % slides.length;
    slides[current].classList.add('active');
    dots[current].classList.add('active');
  }

  function next() { goTo(current + 1); }
  function prev() { goTo(current - 1); }

  function startTimer() { timer = setInterval(next, 4000); }
  function stopTimer() { clearInterval(timer); }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { stopTimer(); goTo(i); startTimer(); });
  });

  document.getElementById('kj-next').addEventListener('click', () => { stopTimer(); next(); startTimer(); });
  document.getElementById('kj-prev').addEventListener('click', () => { stopTimer(); prev(); startTimer(); });

  startTimer();
</script>
